# CognoDB connection details (from console.cognodb.com)
# Copy this file to .env and fill in your own values. Never commit .env.
NEO4J_URI=bolt+s://<your-instance-id>.databases.cognodb.cloud
NEO4J_USERNAME=cognodb
NEO4J_PASSWORD=<your-generated-password>

PORT=4000

# Comma-separated list of origins allowed to call the API (your deployed frontend URL)
CORS_ORIGIN=http://localhost:5173
